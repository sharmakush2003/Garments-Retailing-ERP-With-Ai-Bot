# Node.js Server Environment Configuration

PORT=3000
USE_REDIS=false

# --- MySQL Database Configuration ---
# If these variables are defined, the app connects to this MySQL database.
# Otherwise, it falls back to in-memory SQLite databases for testing.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=digify_master

# --- Redis Cache Configuration (BullMQ Queue) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- AI Semantic Parser Configuration ---
# Provide this key to enable real semantic natural language understanding.
# If empty, the app falls back to rule-based regex parsing.
OPENAI_API_KEY=

# --- WhatsApp Provider Configuration ---
# Choose provider: META or AUTOBOTCHAT
WHATSAPP_PROVIDER=AUTOBOTCHAT

# --- Meta WhatsApp Cloud API Configuration (Optional) ---
META_VERIFY_TOKEN=automatex_copilot_token
META_ACCESS_TOKEN=MOCK_TOKEN
META_WABA_ID=MOCK_WABA

# --- AutobotChat / Goshort API Configuration (Optional) ---
AUTOBOTCHAT_JWT_TOKEN=your_autobotchat_jwt_token_here
AUTOBOTCHAT_USERNAME=Digify_soft
